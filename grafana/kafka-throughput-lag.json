{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Kafka broker CPU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"logstream-kafka\",pod=~\"telemetry-broker-.*\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Consumer group lag (placeholder)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{namespace=\"logstream-kafka\",consumergroup=~\"stream-worker|ansible-eda\"}",
          "legendFormat": "{{consumergroup}} {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Broker PVC used bytes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"logstream-kafka\",persistentvolumeclaim=~\"data-0-telemetry-broker-.*\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["kafka", "logstream"],
  "templating": {
    "list": [
      {
        "name": "datasource",
